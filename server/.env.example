# Application Environment
APP_ENV=development
API_V1_STR=/api/v1
SECRET_KEY=supersecretkey-smart-parcel-locker-change-in-production

# Database (SQLite default for quick local dev, or postgresql://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///./parcel_locker.db

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Face ID (YuNet + SFace ONNX models & Edge Device Key - auto-generated by ./setup.sh)
FACE_DEVICE_KEY=
FACE_YUNET=edge/models/face/face_detection_yunet_2023mar.onnx
FACE_SFACE=edge/models/face/face_recognition_sface_2021dec.onnx

# Edge Security & Limits
OTP_VALID_HOURS=72
OTP_LENGTH=6
MAX_OTP_ATTEMPTS=3
WEIGHT_TOLERANCE_GRAMS=150
