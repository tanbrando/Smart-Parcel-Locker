# ==============================================================================
# SMART PARCEL LOCKER - EDGE NODE CONFIGURATION (.env)
# ==============================================================================

# 1. KẾT NỐI MÁY CHỦ TRUNG TÂM (SERVER BACKEND)
# Điền địa chỉ IP của máy tính chạy server (hoặc VPS Cloud) trong cùng mạng Wi-Fi / LAN
SERVER_API_URL=http://192.168.1.100:8000
API_TIMEOUT_SECONDS=15.0

# 2. CHẾ ĐỘ HOẠT ĐỘNG PHẦN CỨNG
# Chạy trên Raspberry Pi thật: đặt là false
# Chạy giả lập trên máy tính / không có linh kiện: đặt là true
MOCK_HARDWARE=false

# 3. CẤU HÌNH CAMERA QUÉT MÃ
# 'raspberry': Kích hoạt camera thực tế trên Pi
# 'test': Sử dụng ảnh mẫu tĩnh trong thư mục test
CAMERA_MODE=raspberry

# true: Dùng camera dải băng Raspberry Pi Camera Module qua cổng CSI (Picamera2 / libcamerasrc)
# false: Dùng USB Webcam qua V4L2
USE_CSI_CAMERA=true
CAMERA_INDEX=0

# 4. TỐI ƯU HÓA TRỌNG SỐ PADDLEOCR OFFLINE TRÊN CPU PI
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
DISABLE_MODEL_SOURCE_CHECK=True
FLAGS_use_mkldnn=0
FLAGS_enable_pir_api=0

# 5. CẤU HÌNH PHẦN CỨNG GPIO (MẶC ĐỊNH BCM)
# Servo Pins: 1: GPIO 17, 2: GPIO 27, 3: GPIO 22
# Load Cell HX711: DT=5, SCK=6, Calib=420.0, Sai số cho phép=150.0g
# Matrix Keypad 4x4: Rows=[18, 23, 24, 25], Cols=[12, 16, 20, 21]
# LCD 1602 (I2C): Bus=1, Addr=0x27
# Buzzer: Pin=26

