# ==============================================================================
# SMART PARCEL LOCKER - EDGE NODE CONFIGURATION (.env) - RASPBERRY PI 4B
# ==============================================================================

# 1. KẾT NỐI MÁY CHỦ TRUNG TÂM (SERVER BACKEND)
# Khi chạy chung trên Pi bằng ./run_all.sh, mặc định là http://127.0.0.1:8000
SERVER_API_URL=http://127.0.0.1:8000
API_TIMEOUT_SECONDS=15.0

# 2. CHẾ ĐỘ HOẠT ĐỘNG PHẦN CỨNG
# Chạy trên Raspberry Pi thật: false | Giả lập không cần linh kiện: true
MOCK_HARDWARE=false

# 3. CẤU HÌNH CAMERA QUÉT MÃ & FACE ID
# 'raspberry': Camera thực tế trên Pi | 'test': Ảnh mẫu tĩnh
CAMERA_MODE=raspberry
USE_CSI_CAMERA=true
CAMERA_INDEX=0

# 4. CẤU HÌNH CẢM BIẾN SIÊU ÂM HC-SR04 & CÔNG TẮC CỬA (4 NGĂN TỦ)
BASELINE_EMPTY_CM=35.0
OCCUPIED_MARGIN_CM=5.0
MIN_FREE_DISTANCE_CM=8.0
# Danh sách ngăn tủ đã gắn Servo (VD: 3,4 nếu chỉ test trước 2 tủ 3 & 4)
ACTIVE_LOCKER_IDS=1,2,3,4
# Đặt false nếu chưa gắn cảm biến siêu âm HC-SR04 (tự giả lập có hàng 14cm để chạy full)
ENABLE_ULTRASONIC=true
# Đặt false nếu mô hình chưa gắn 4 công tắc từ Reed Switch
ENABLE_DOOR_SWITCH=true

# 5. CẤU HÌNH MỞ TỦ BẰNG FACE ID (TỰ ĐỘNG SINH KEY & TẢI MODEL KHI CHẠY ./setup.sh)
FACE_DEVICE_KEY=
FACE_YUNET=edge/models/face/face_detection_yunet_2023mar.onnx
FACE_SFACE=edge/models/face/face_recognition_sface_2021dec.onnx

# 6. TỐI ƯU HÓA TRỌNG SỐ PADDLEOCR OFFLINE TRÊN CPU PI
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
DISABLE_MODEL_SOURCE_CHECK=True
FLAGS_use_mkldnn=0
FLAGS_enable_pir_api=0

# 7. SƠ ĐỒ CHÂN GPIO CHUẨN KHÔNG XUNG ĐỘT (BCM - PI 4B)
# - I2C LCD 1602 (0x27) : GPIO 2 (SDA), GPIO 3 (SCL)
# - 4x Servo khóa cửa   : Locker 1=17, 2=27, 3=22, 4=4
# - 4x HC-SR04 Siêu âm  : TRIG chung=5 | ECHO: Locker 1=6, 2=13, 3=19, 4=26 (chia áp 5V->3.3V!)
# - 4x Công tắc cửa     : Locker 1=7, 2=8, 3=9, 4=11
# - Keypad 4x4          : Rows=[18, 23, 24, 25], Cols=[12, 16, 20, 21]
# - Buzzer              : GPIO 10
